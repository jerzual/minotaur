{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"vitest",
		"react",
		"typescript",
		"oxc",
		"unicorn",
		"import",
		"jsx-a11y",
		"react-perf",
		"promise",
		"eslint"
	],
	"categories": {
		"correctness": "off"
	},
	"env": {
		"builtin": true
	},
	"overrides": [
		{
			"files": ["*.ts", "*.tsx"],
			"env": {
				"browser": true,
				"jest": true,
				"node": true
			}
		}
	]
}
